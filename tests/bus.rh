bus 'rh/interfaces/axi4/1.0' do
	maxMasters 16
	maxSlaves 16
end
abstraction 'rh/interfaces/axi4/1.0' do ##{{{
	bus 'rh/interfaces/axi4/1.0'
	parameter :ADDR_WIDTH=>32,:DATA_WIDTH=>32
	wire 'ACLK', :clock do
		onSystem :direction=>:in
		onMaster :direction=>:in
		onSlave  :direction=>:in
	end
end ##}}}