rhload 'component.rh'
design 'Rh/rtl/IpDesignExample/1.0' do ##{{{
	# this is the design description node example.
	# rtl of fifo ip , top rtl, core rtl and common rtl.
	instance 'rh/rtl/fifo/1.0', :as => :rtl;

	# dv of fifo ip, all dv information like env, tests and tb
	instance 'rh/dv/fifo/1.0', :as => :dv;
	mapping do ##{{{
		# describe the mapping information such as the register map for generating ral model.
		#TODO
	end ##}}}

	# for bus connection
	# dv.dut_bus returns the BusInterface object.
	# dv is the ComponentInstance object which need to build the interface information so that calling the
	# dv.dut_bus can get the dut_bus object of component.
	connect :bus, dv.dut_bus=>rtl.bus do ##{{{
		# TODO, port connection
	end ##}}}
	# for adhoc connection
	connect :adhoc, dv.dut_clk=>rtl.clki, dv.dut_rst=>rtl.rstn;
	#TODO, ...

	# TODO, used when the rtl is an instance of a design object, this always used by soc level who want to instance an ip's design object.
	#TODO, connect :hier, dv.hbus=>rtl.subc.bus

end ##}}}

