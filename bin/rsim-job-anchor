#! /usr/bin/env ruby
# this is the job anchor script which will get command by the given -e args, and add operation for 
# building, modifying anchors.
# format:
# rsim-job-anchor "<commands>" "path"

$anchors = ["RUNNING","COMPLETE","KILLED"]

## buildAnchor(path,pid), description
def buildAnchor(path,pid,name); ##{{{
	$anchors.each do |a|
		fn=File.join(path,"#{a}.#{pid}");
		system("rm -f #{fn}") if File.exist?(fn);
	end
	fn=File.join(path,"#{name}.#{pid}");
	fh=File.open(fn,'w');
	fh.write("#{pid}\n");
	fh.close;
end ##}}}


require 'open3'

## main, description
def main; ##{{{
	signal = 0;

	cmd = ARGV.shift;
	path= ARGV.shift;
	pid = Process.pid;
	
	buildAnchor(path,pid,'RUNNING')
	out,err,st = Open3.capture3(%Q|cd #{path};#{cmd}|);
	#TODO, can add out,err, st information into complete anchor.
	#puts "#{err.class}";
	logn=cmd.gsub(/ /,'-')+'.log';
	logh=File.open(File.join(path,logn),'w');
	if st.exitstatus==0
		logh.write("#{out}");
	else
		logh.write("#{err}");
	end
	logh.write("#{st.exitstatus}\n");
	logh.close;

	buildAnchor(path,pid,'COMPLETE')

	return st.exitstatus;
end ##}}}

exit main;
